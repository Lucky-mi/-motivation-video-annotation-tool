# ========================================
# 视频标注系统 V3 - 环境变量配置
# ========================================

# Google Gemini API Key (必填)
# 申请地址: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini 模型选择 (可选，默认: gemini-2.0-flash)
# 可选值: gemini-2.0-flash, gemini-1.5-pro, gemini-1.5-flash
GEMINI_MODEL=gemini-2.0-flash

# ========================================
# 使用说明：
# 1. 复制此文件为 .env
#    cp .env.example .env
#
# 2. 填入你的 Gemini API Key
#
# 3. (可选) 如需更高质量标注，可改用 gemini-1.5-pro
# ========================================
